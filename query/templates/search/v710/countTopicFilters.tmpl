,
"filter": [
  {
    "bool": {
      "must": [
        {
          "bool": {
            "should": [
              {{ template "contentTypeFilter.tmpl" . }}
            ]
          }
        }
        {{ if .URIPrefix }}
        , {
          "bool": {
            "should": [
              {{ template "contentFilterOnURIPrefix.tmpl" . }}
            ]
          }
        }
        {{ end }}
        {{ if .URIs }}
        , {
          "bool": {
            "should": [
              {{ template "uriFilters.tmpl" . }}
            ]
          }
        }
        {{ end }}
        {{ if .Dimensions }}
        , {
          "bool": {
            "must": [
              {{ template "dimensionsFilters.tmpl" . }}
            ]
          }
        }
        {{ end }}
      ]
    }
  }
]
