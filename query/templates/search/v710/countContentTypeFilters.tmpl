,
"filter": [
{
  "bool": {
    "must": [
      {
        "bool": {
          "should": [
            {{ template "topicFilters.tmpl" . }}
            {{ template "contentFilterOnURIPrefix.tmpl" . }}
            {{ template "contentFilterOnTopicWildcard.tmpl" . }}
          ]
        }
      }
      {{ if .URIs }}
      , {
        "bool": {
          "should": [
            {{ template "uriFilters.tmpl" . }}
          ]
        }
      }
      {{ end }}
      {{ if .Dimensions }}
      , {
        "bool": {
          "must": [
            {{ template "dimensionsFilters.tmpl" . }}
          ]
        }
      }
      {{ end }}
      ]
    }
  }
]
